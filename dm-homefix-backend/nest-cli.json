{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "services/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "services/api-gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "services/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "services/api-gateway",
      "entryFile": "main",
      "sourceRoot": "services/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "services/api-gateway/tsconfig.app.json"
      }
    },
    "account-service": {
      "type": "application",
      "root": "services/account-service",
      "entryFile": "main",
      "sourceRoot": "services/account-service/src",
      "compilerOptions": {
        "tsConfigPath": "services/account-service/tsconfig.app.json"
      }
    },
    "technician-verification-service": {
      "type": "application",
      "root": "services/technician-verification-service",
      "entryFile": "main",
      "sourceRoot": "services/technician-verification-service/src",
      "compilerOptions": {
        "tsConfigPath": "services/technician-verification-service/tsconfig.app.json"
      }
    },
    "service-catalog-service": {
      "type": "application",
      "root": "services/service-catalog-service",
      "entryFile": "main",
      "sourceRoot": "services/service-catalog-service/src",
