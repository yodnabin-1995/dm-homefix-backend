      "compilerOptions": {
        "tsConfigPath": "services/pricing-quote-service/tsconfig.app.json"
      }
    },
    "job-management-service": {
      "type": "application",
      "root": "services/job-management-service",
      "entryFile": "main",
      "sourceRoot": "services/job-management-service/src",
