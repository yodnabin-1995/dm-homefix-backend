        "tsConfigPath": "services/review-complaint-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "services/notification-service",
      "entryFile": "main",
      "sourceRoot": "services/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "services/notification-service/tsconfig.app.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
