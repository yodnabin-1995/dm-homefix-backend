# ─── Node ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=dmhomefix
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=dmhomefix

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=dmhomefix
RABBITMQ_PASS=change_me_in_production

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_different_64_byte_hex_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── OTP / Contact Verification ──────────────────────────────────────────────
# DEV: OTP is logged to console (no real SMS/email sent)
# PROD: set OTP_CHANNEL=sms or OTP_CHANNEL=email and configure the provider
OTP_SECRET=replace_with_otp_secret
OTP_CHANNEL=mock
# SMS_PROVIDER_API_KEY=
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=

# ─── MinIO (S3-compatible Object Storage) ────────────────────────────────────
# DEV: MinIO runs in Docker on localhost:9000
# Console UI: http://localhost:9001  (login with MINIO_ACCESS_KEY / MINIO_SECRET_KEY)
# PROD: point MINIO_ENDPOINT at your production MinIO server or swap for AWS S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=dmhomefix
MINIO_SECRET_KEY=change_me_in_production
MINIO_REGION=us-east-1
# Buckets are created automatically on service start:
#   verification-docs  → private (pre-signed URLs only)
#   profile-images     → public read

# ─── Payment Provider ─────────────────────────────────────────────────────────
# DEV: mock adapter (no real payments)
# PROD: configure a real provider before go-live
PAYMENT_PROVIDER=mock
# CHAPA_SECRET_KEY=
# CHAPA_WEBHOOK_SECRET=

# ─── Service URLs (used by API Gateway) ──────────────────────────────────────
ACCOUNT_SERVICE_URL=http://localhost:3001
TECHNICIAN_VERIFICATION_SERVICE_URL=http://localhost:3002
SERVICE_CATALOG_SERVICE_URL=http://localhost:3003
BOOKING_SERVICE_URL=http://localhost:3004
PRICING_QUOTE_SERVICE_URL=http://localhost:3005
JOB_MANAGEMENT_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3007
REVIEW_COMPLAINT_SERVICE_URL=http://localhost:3008
NOTIFICATION_SERVICE_URL=http://localhost:3009

# ─── Service Ports ───────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
ACCOUNT_SERVICE_PORT=3001
TECHNICIAN_VERIFICATION_SERVICE_PORT=3002
SERVICE_CATALOG_SERVICE_PORT=3003
BOOKING_SERVICE_PORT=3004
PRICING_QUOTE_SERVICE_PORT=3005
JOB_MANAGEMENT_SERVICE_PORT=3006
PAYMENT_SERVICE_PORT=3007
REVIEW_COMPLAINT_SERVICE_PORT=3008
NOTIFICATION_SERVICE_PORT=3009
